# Copy to .env and fill in. Never commit the real .env (already gitignored at repo root).

# Provider API key for whichever model FTI_AGENT_MODEL selects.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangChain init_chat_model spec: "<provider>:<model>", e.g. "anthropic:claude-sonnet-5"
# or "openai:gpt-4.1". Provider prefix picks which API key above is actually used.
FTI_AGENT_MODEL=anthropic:claude-sonnet-5

# Optional: custom API base for compatible servers (e.g., LM Studio, local Ollama).
# If set, overrides the default endpoint for the provider.
# Example for LM Studio: http://localhost:1234/v1
FTI_AGENT_API_BASE=

# Absolute path to feature_pipeline_hub/. Defaults to the sibling directory next to
# this project if unset — only needed if you've moved the two projects apart.
FTI_AGENT_HUB_DIR=

# Hard cap on model-call/tool-call round trips within a single user turn.
FTI_AGENT_MAX_ITERATIONS=15
