# Dataset working folders: keep the directory skeleton, never the contents.
# Repo-wide media/model ignores live in the root .gitignore.
data/raw/**
data/processed/**
!data/raw/**/
!data/processed/**/
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep

# Never upload images (png, jpg, jpeg, webp, etc.)
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.jfif
*.JFIF
*.webp
*.WEBP
*.gif
*.GIF
*.bmp
*.BMP
*.tif
*.TIF
*.tiff
*.TIFF
*.heic
*.HEIC
*.heif
*.HEIF
*.avif
*.AVIF
*.psd
*.PSD
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[aA][vV][iI][fF]

# Local output & virtual environments
.venv/
.venv*/
venv/
venv*/
output_local/
out_x/
cache_x/

# Local metadata DB produced during curation
*.db
*.sqlite3

# Self-contained training environment: copied model weights (~46GB), a
# dedicated venv, exported datasets, caches, and run logs/checkpoints. Never
# code, never tracked — see scripts/setup_training_runtime.sh.
training_runtime/

# Hugging Face tokens and local credentials (never track secrets)
HF_token.json
*token*.json
*.token
.hf_token
.env
.env.*

# Local application settings (contain private paths and tokens)
data/hub_config.json
hub_config.json
!data/hub_config.example.json
!hub_config.example.json
