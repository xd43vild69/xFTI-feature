# Dataset working folders: keep the directory skeleton, never the contents.
# Repo-wide media/model ignores live in the root .gitignore.
data/raw/**
data/processed/**
!data/raw/**/
!data/processed/**/
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep

# Local metadata DB produced during curation
*.db
*.sqlite3

# Self-contained training environment: copied model weights (~46GB), a
# dedicated venv, exported datasets, caches, and run logs/checkpoints. Never
# code, never tracked — see scripts/setup_training_runtime.sh.
training_runtime/

# Hugging Face tokens and local credentials (never track secrets)
HF_token.json
*token*.json
*.token
.hf_token
.env
.env.*
